# Normalize line endings: LF in the repo and in the working tree on every OS (Windows included).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.bin binary
