#!/bin/sh
# Compile the firmware: `script/compile [CONFIG]` (default garden-pilot.yaml).
#
# ESPHome version: GP_ESPHOME (pinned | minimum | latest | YYYY.M.P), see script/_esphome.
# Uses the real secrets.yaml when it exists, otherwise (or with GP_SECRETS=example) the config is staged with
# secrets.example.yaml into the git-ignored .esphome/example-build/ and compiled there, so no secrets.yaml is
# ever created in the checkout. The staging dir is fixed so reruns are incremental. A config in a subdirectory
# (examples/) without <dir>/secrets.yaml is staged the same way, with the root secrets.yaml if present.
set -eu
cd "$(dirname "$0")/.."

CONFIG="${1:-garden-pilot.yaml}"
if [ ! -f "$CONFIG" ]; then
    echo "config file not found: $CONFIG" >&2
    exit 1
fi

echo "ESPHome $(sh script/_esphome version | sed 's/^Version: //')"

CONFIG_DIR="$(dirname "$CONFIG")"
if [ "${GP_SECRETS:-}" != "example" ] && [ "$CONFIG_DIR" = "." ] && [ -f secrets.yaml ]; then
    exec sh script/_esphome compile "$CONFIG"
fi
if [ "${GP_SECRETS:-}" != "example" ] && [ "$CONFIG_DIR" != "." ] && [ -f "$CONFIG_DIR/secrets.yaml" ]; then
    exec sh script/_esphome compile "$CONFIG"
fi

# Staged: the config at its relative path (examples/x.yaml keeps its ../ includes) with the secrets file next to it.
SECRETS=secrets.example.yaml
if [ "${GP_SECRETS:-}" != "example" ] && [ -f secrets.yaml ]; then
    SECRETS=secrets.yaml
fi
STAGE=".esphome/example-build"
mkdir -p "$STAGE/.esphome"
# Refresh the staged sources; keep the nested .esphome/ build dir.
find "$STAGE" -mindepth 1 -maxdepth 1 ! -name .esphome -exec rm -r -f {} +
# Everything an entry file may include; keep in sync with script/config.
for path in packages hardware components; do
    if [ -e "$path" ]; then
        cp -R "$path" "$STAGE/"
    fi
done
mkdir -p "$STAGE/$CONFIG_DIR"
cp "$CONFIG" "$STAGE/$CONFIG"
cp "$SECRETS" "$STAGE/$CONFIG_DIR/secrets.yaml"
if [ "$SECRETS" = secrets.example.yaml ]; then
    echo "Built with example secrets: do not flash this firmware."
fi
exec sh script/_esphome compile "$STAGE/$CONFIG"
