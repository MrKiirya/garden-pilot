#!/bin/sh
# All checks: pytest (unit repo checks + `esphome config`).
set -eu
cd "$(dirname "$0")/.."

# Parallel by default (pytest-xdist): `--dist loadgroup` keeps every host build and its tests on one worker (see
# HOST_GROUPS in tests/conftest.py). GP_PYTEST_WORKERS=0 runs serially (debugging); a number caps the workers.
# Extra arguments pass through, e.g. `script/test -m unit` or `script/test --durations=25`.
uv run --no-sync pytest -n "${GP_PYTEST_WORKERS:-auto}" --dist loadgroup "$@"
