{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(script/setup *)",
      "Bash(script/lint *)",
      "Bash(script/test *)",
      "Bash(script/config *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run yamllint *)",
      "Bash(uv run esphome config *)",
      "Bash(uv run esphome compile *)",
      "Bash(uv run esphome version)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh repo view *)",

      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b task/*)",
      "Bash(git push -u origin task/*)",
      "Bash(git push origin task/*)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull --ff-only)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",

      "WebFetch(domain:esphome.io)",
      "WebFetch(domain:developers.esphome.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.lvgl.io)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:docs.platformio.org)"
    ],
    "ask": [
      "Bash(uv run esphome run *)",
      "Bash(uv run esphome upload *)",
      "Bash(uv run esphome logs *)",
      "Bash(uv add *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(rm -rf *)",
      "Read(./secrets.yaml)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
